<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.merchant.server.merchantservice.mapper.InvoiceMapper">

    <!-- Result Map -->
    <resultMap id="InvoiceResultMap" type="com.merchant.server.merchantservice.entity.Invoice">
        <id property="id" column="id"/>
        <result property="invoiceNumber" column="invoice_number"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="tenantName" column="tenant_name"/>
        <result property="subscriptionId" column="subscription_id"/>
        <result property="subtotal" column="subtotal"/>
        <result property="taxRate" column="tax_rate"/>
        <result property="taxAmount" column="tax_amount"/>
        <result property="amount" column="amount"/>
        <result property="currency" column="currency"/>
        <result property="taxRegion" column="tax_region"/>
        <result property="billingPeriodStart" column="billing_period_start"/>
        <result property="billingPeriodEnd" column="billing_period_end"/>
        <result property="status" column="status"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="paymentDate" column="payment_date"/>
        <result property="stripeInvoiceId" column="stripe_invoice_id"/>
        <result property="stripePaymentIntentId" column="stripe_payment_intent_id"/>
        <result property="description" column="description"/>
        <result property="notes" column="notes"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- Base Column List -->
    <sql id="Base_Column_List">
        id, invoice_number, tenant_id, tenant_name, subscription_id,
        subtotal, tax_rate, tax_amount, amount, currency, tax_region,
        billing_period_start, billing_period_end, status, payment_method, payment_date,
        stripe_invoice_id, stripe_payment_intent_id, description, notes,
        created_at, updated_at
    </sql>

    <!-- 根据ID查询账单 -->
    <select id="findById" resultMap="InvoiceResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM invoices
        WHERE id = #{id}
    </select>

    <!-- 根据租户ID查询账单列表 -->
    <select id="findByTenantId" resultMap="InvoiceResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM invoices
        WHERE tenant_id = #{tenantId}
        ORDER BY created_at DESC
    </select>

    <!-- 根据账单号查询账单 -->
    <select id="findByInvoiceNumber" resultMap="InvoiceResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM invoices
        WHERE invoice_number = #{invoiceNumber}
    </select>

    <!-- 创建账单 -->
    <insert id="insert" parameterType="com.merchant.server.merchantservice.entity.Invoice" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO invoices (
            invoice_number, tenant_id, tenant_name, subscription_id,
            subtotal, tax_rate, tax_amount, amount, currency, tax_region,
            billing_period_start, billing_period_end, status, payment_method, payment_date,
            stripe_invoice_id, stripe_payment_intent_id, description, notes
        ) VALUES (
            #{invoiceNumber}, #{tenantId}, #{tenantName}, #{subscriptionId},
            #{subtotal}, #{taxRate}, #{taxAmount}, #{amount}, #{currency}, #{taxRegion},
            #{billingPeriodStart}, #{billingPeriodEnd}, #{status}, #{paymentMethod}, #{paymentDate},
            #{stripeInvoiceId}, #{stripePaymentIntentId}, #{description}, #{notes}
        )
    </insert>

    <!-- 更新账单 -->
    <update id="update" parameterType="com.merchant.server.merchantservice.entity.Invoice">
        UPDATE invoices
        <set>
            <if test="subscriptionId != null">subscription_id = #{subscriptionId},</if>
            <if test="subtotal != null">subtotal = #{subtotal},</if>
            <if test="taxRate != null">tax_rate = #{taxRate},</if>
            <if test="taxAmount != null">tax_amount = #{taxAmount},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="currency != null">currency = #{currency},</if>
            <if test="taxRegion != null">tax_region = #{taxRegion},</if>
            <if test="billingPeriodStart != null">billing_period_start = #{billingPeriodStart},</if>
            <if test="billingPeriodEnd != null">billing_period_end = #{billingPeriodEnd},</if>
            <if test="status != null">status = #{status},</if>
            <if test="paymentMethod != null">payment_method = #{paymentMethod},</if>
            <if test="paymentDate != null">payment_date = #{paymentDate},</if>
            <if test="stripeInvoiceId != null">stripe_invoice_id = #{stripeInvoiceId},</if>
            <if test="stripePaymentIntentId != null">stripe_payment_intent_id = #{stripePaymentIntentId},</if>
            <if test="description != null">description = #{description},</if>
            <if test="notes != null">notes = #{notes},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除账单 -->
    <delete id="delete">
        DELETE FROM invoices
        WHERE id = #{id}
    </delete>

    <!-- 根据订阅ID查询账单列表 -->
    <select id="findBySubscriptionId" resultMap="InvoiceResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM invoices
        WHERE subscription_id = #{subscriptionId}
        ORDER BY created_at DESC
    </select>

</mapper>
