<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.merchant.server.businessservice.mapper.OrderServiceMapper">

    <resultMap id="BaseResultMap" type="com.merchant.server.businessservice.entity.OrderService">
        <id column="id" property="id" />
        <result column="order_id" property="orderId" />
        <result column="service_id" property="serviceId" />
        <result column="service_name" property="serviceName" />
        <result column="service_category" property="serviceCategory" />
        <result column="price" property="price" />
        <result column="quantity" property="quantity" />
        <result column="duration" property="duration" />
        <result column="assigned_resource_id" property="assignedResourceId" />
        <result column="assigned_resource_type" property="assignedResourceType" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT * FROM order_services WHERE order_id = #{orderId}
    </select>

    <insert id="insert" parameterType="com.merchant.server.businessservice.entity.OrderService" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_services (order_id, service_id, service_name, service_category, price, quantity,
        duration, assigned_resource_id, assigned_resource_type, created_at, updated_at)
        VALUES (#{orderId}, #{serviceId}, #{serviceName}, #{serviceCategory}, #{price}, #{quantity},
        #{duration}, #{assignedResourceId}, #{assignedResourceType}, #{createdAt}, #{updatedAt})
    </insert>

    <delete id="deleteByOrderId">
        DELETE FROM order_services WHERE order_id = #{orderId}
    </delete>

</mapper>