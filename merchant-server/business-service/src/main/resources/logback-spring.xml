<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-NO_TRACE}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 文件输出 - 自动日志轮换 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>../logs/business-service.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 每天轮换，文件名包含日期 -->
            <fileNamePattern>../logs/business-service.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 保留30天的历史日志 -->
            <maxHistory>30</maxHistory>
            <!-- 总大小不超过3GB -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-NO_TRACE}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 应用程序日志 - 输出到控制台和文件 -->
    <logger name="com.merchant.server.businessservice" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- 减少MyBatis和Spring框架的日志输出 -->
    <logger name="com.merchant.server.businessservice.mapper" level="WARN" additivity="false"/>
    <logger name="org.apache.ibatis" level="WARN" additivity="false"/>
    <logger name="java.sql" level="WARN" additivity="false"/>
    <logger name="org.mybatis" level="ERROR" additivity="false"/>
    <logger name="org.springframework" level="WARN" additivity="false"/>
    <logger name="org.springframework.cloud" level="WARN" additivity="false"/>
    <logger name="com.netflix" level="WARN" additivity="false"/>

    <!-- 根日志级别 -->
    <root level="WARN"/>
</configuration>