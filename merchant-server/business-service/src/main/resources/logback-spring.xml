<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 日志目录配置 - 使用环境变量，默认为当前目录的logs -->
    <springProperty scope="context" name="LOG_HOME" source="logging.file.path" defaultValue="../logs"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-NO_TRACE}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 文件输出 - 自动日志轮换 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/business-service.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 每天轮换，文件名包含日期 -->
            <fileNamePattern>${LOG_HOME}/business-service.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 保留30天的历史日志 -->
            <maxHistory>30</maxHistory>
            <!-- 总大小不超过3GB -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-NO_TRACE}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 应用程序日志 -->
    <logger name="com.merchant.server.businessservice" level="INFO" additivity="false">
        <appender-ref ref="FILE"/>
    </logger>

    <!-- 降低框架日志噪音 -->
    <logger name="com.merchant.server.businessservice.mapper" level="WARN"/>
    <logger name="org.apache.ibatis" level="WARN"/>
    <logger name="java.sql" level="WARN"/>
    <logger name="org.mybatis" level="ERROR"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.cloud" level="WARN"/>
    <logger name="org.springframework.context.support.PostProcessorRegistrationDelegate" level="ERROR"/>
    <logger name="org.springframework.cloud.loadbalancer" level="ERROR"/>
    <logger name="com.netflix" level="WARN"/>

    <!-- 根日志级别 - 根据profile区分 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

</configuration>
