FROM openjdk:17-jdk-slim

# Set timezone argument (can be overridden at build time)
ARG TIMEZONE=America/Vancouver

# Install timezone data and set timezone
RUN apt-get update && apt-get install -y tzdata \
    && ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime \
    && echo "${TIMEZONE}" > /etc/timezone \
    && dpkg-reconfigure -f noninteractive tzdata \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set timezone environment variables
ENV TZ=${TIMEZONE}
ENV JAVA_OPTS="-Duser.timezone=${TIMEZONE}"

WORKDIR /app

# 复制jar文件
COPY merchant-server/analytics-service/target/analytics-service-*.jar app.jar

# 暴露端口
EXPOSE 8085

# 启动应用
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]